  m_Script: {fileID: 11500000, guid: a0ab13adfc54eb84f96c8df9ba2b8855, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialDialogue
  dialogueText: 'Press "Q" near an object to grab it

    - Left click to swing an
    object, but you have to wait a while to swing it again so time it carefully.
    Note that some objects have a different functionalities.

    - Right click to
    throw an object which can hit the target from a distance.

    - Some objects
    are very big which can slow your character rotation, as well as unable to throw
    it.'
  uiDialogueTextField: {fileID: 1230841795}
